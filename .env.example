# ==========================================================
# Tiles ERP - Root Environment Variables (example)
# Copy to .env and adjust. Never commit real .env files.
# ==========================================================

NODE_ENV=development

# ---------- PostgreSQL ----------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=tileserp
POSTGRES_PASSWORD=tileserp_password
POSTGRES_DB=tileserp
DATABASE_URL=postgresql://tileserp:tileserp_password@localhost:5432/tileserp?schema=public

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# ---------- API ----------
API_PORT=3000
API_GLOBAL_PREFIX=api
# "lan" allows localhost + private-network origins (phones/laptops on the same Wi-Fi).
# Use explicit origins (or "*") in production.
API_CORS_ORIGINS=lan
SWAGGER_ENABLED=true
# Serve the API over HTTPS. Required when the PWAs run over HTTPS (mixed content is
# blocked), e.g. when installing the app on a phone. A self-signed certificate is
# generated into apps/api/certs on first start.
API_HTTPS=false
# API_SSL_KEY_FILE=
# API_SSL_CERT_FILE=

# ---------- JWT ----------
JWT_ACCESS_SECRET=change_me_access_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d

# ---------- Worker ----------
WORKER_CONCURRENCY=5

# ---------- Email (SMTP) ----------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Tiles ERP <no-reply@tileserp.local>"

# ---------- File Upload ----------
UPLOAD_DIR=./uploads
UPLOAD_MAX_FILE_SIZE=10485760

# ---------- SixOrbit ----------
# Encrypts the SixOrbit password stored in the database. 32 bytes, base64:
#   openssl rand -base64 32
# Base URL, API key, email and password are NOT here — they live in sixorbit_config and
# are edited from Settings -> SixOrbit, so changing them needs no redeploy.
# Rotating this key makes the stored password unreadable; re-enter it after rotating.
SIXORBIT_ENC_KEY=
