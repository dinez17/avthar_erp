# ==========================================================================
# Tiles ERP — production environment.
#
# Copy to .env.production ON THE SERVER and fill in real values:
#     cp .env.production.example .env.production
#     chmod 600 .env.production
#
# .env.production must never be committed. Every value below without a default
# is required — the stack refuses to start if one is missing, which is
# deliberate: a missing secret should stop a deploy, not ship a weak default.
# ==========================================================================

# ---------- Domains ----------
# Must already resolve to this server's public IP before the first deploy.
ADMIN_DOMAIN=erp.avtharceramics.co.in
SUPPLIER_DOMAIN=supplier.avtharceramics.co.in
CUSTOMER_DOMAIN=customer.avtharceramics.co.in

# Email Let's Encrypt uses for expiry warnings. Must be one you actually read —
# it is where the "certificate expiring" warnings go if auto-renewal breaks.
LETSENCRYPT_EMAIL=

# ---------- PostgreSQL ----------
# Reachable only on the internal Docker network — never published to the host.
POSTGRES_USER=tileserp
# Generate:  openssl rand -base64 32
POSTGRES_PASSWORD=
POSTGRES_DB=tileserp

# ---------- Redis ----------
# Generate:  openssl rand -base64 32
REDIS_PASSWORD=

# ---------- JWT ----------
# Minimum 16 characters (enforced by the env schema). Generate each separately:
#   openssl rand -base64 48
# Rotating these invalidates every issued token and logs all users out.
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# ---------- First admin user (seed) ----------
# Used once, on the first deploy. Change the password after your first login.
SEED_ADMIN_EMAIL=admin@avtharceramics.co.in
SEED_ADMIN_PASSWORD=
# Set to false after the first successful deploy to skip re-running the seed.
RUN_SEED=true

# ---------- Worker ----------
# Number of jobs processed at once. 3 suits a 2-core VPS; raise it only after you
# see the queue backing up AND the CPU sitting idle.
WORKER_CONCURRENCY=3

# ---------- Email (SMTP) ----------
# A real provider — SES, SendGrid, Postmark, or your mail host.
# Port 587 with SMTP_SECURE=false means STARTTLS; port 465 needs SMTP_SECURE=true.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Avthar Ceramics ERP <no-reply@avtharceramics.co.in>"

# ---------- File upload ----------
# 10 MB. Keep at or below the gateway's client_max_body_size (20m).
UPLOAD_MAX_FILE_SIZE=10485760

# ---------- SixOrbit ----------
# Encrypts the SixOrbit password stored in the database. Exactly 32 bytes, base64:
#   openssl rand -base64 32
# Base URL, API key, email and password live in sixorbit_config and are edited
# from Settings -> SixOrbit, so changing them needs no redeploy.
# Rotating this key makes the stored password unreadable; re-enter it after rotating.
SIXORBIT_ENC_KEY=
