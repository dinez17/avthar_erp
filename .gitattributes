# ==========================================================================
# Line-ending policy.
#
# Why this file exists: several scripts in this repo are bind-mounted into
# Linux containers and executed there (docker/*.sh) or run on the Ubuntu
# server (scripts/*.sh). If Git checks them out with CRLF on Windows, the
# shell inside the container reads the trailing \r as part of the shebang
# and fails with:
#
#     /bin/sh: bad interpreter: /bin/sh^M
#     $'\r': command not found
#
# Forcing LF on everything the Linux side touches prevents that, regardless
# of each developer's core.autocrlf setting.
# ==========================================================================

# Normalise text files in the repository to LF; let Git decide the working-copy
# ending for anything not pinned below.
* text=auto

# --- Must be LF: executed by Linux ---------------------------------------
*.sh            text eol=lf
*.bash          text eol=lf
Dockerfile      text eol=lf
*.Dockerfile    text eol=lf
.dockerignore   text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.conf          text eol=lf
*.template      text eol=lf
*.sql           text eol=lf
*.prisma        text eol=lf
.env.example    text eol=lf
.env.*.example  text eol=lf

# Source and config: LF keeps diffs clean across machines.
*.ts            text eol=lf
*.tsx           text eol=lf
*.js            text eol=lf
*.jsx           text eol=lf
*.mjs           text eol=lf
*.cjs           text eol=lf
*.json          text eol=lf
*.md            text eol=lf
*.css           text eol=lf
*.html          text eol=lf
*.toml          text eol=lf
*.npmrc         text eol=lf
*.editorconfig  text eol=lf

# --- Must be CRLF: executed by Windows ------------------------------------
*.ps1           text eol=crlf
*.bat           text eol=crlf
*.cmd           text eol=crlf

# --- Binary: never touch ---------------------------------------------------
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.ico           binary
*.woff          binary
*.woff2         binary
*.ttf           binary
*.eot           binary
*.pdf           binary
*.zip           binary
*.tgz           binary
*.gz            binary
*.xlsx          binary

# Lockfile: large, machine-generated — keep diffs out of review noise.
pnpm-lock.yaml  text eol=lf -diff linguist-generated
