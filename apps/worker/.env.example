NODE_ENV=development
DATABASE_URL=postgresql://tileserp:tileserp_password@localhost:5432/tileserp?schema=public
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
API_PORT=3000
API_GLOBAL_PREFIX=api
API_CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
SWAGGER_ENABLED=true
JWT_ACCESS_SECRET=change_me_access_secret_at_least_16
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_refresh_secret_at_least_16
JWT_REFRESH_EXPIRES_IN=7d
WORKER_CONCURRENCY=5
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM="Tiles ERP <no-reply@tileserp.local>"
UPLOAD_DIR=./uploads
UPLOAD_MAX_FILE_SIZE=10485760
