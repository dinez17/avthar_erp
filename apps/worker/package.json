{
  "name": "@tiles-erp/worker",
  "version": "0.1.0",
  "private": true,
  "description": "Tiles ERP - BullMQ background worker (email, notification, audit)",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest --passWithNoTests",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@nestjs/bullmq": "^10.2.3",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@prisma/client": "^6.1.0",
    "@tiles-erp/config": "workspace:*",
    "@tiles-erp/shared": "workspace:*",
    "@tiles-erp/shared-types": "workspace:*",
    "@tiles-erp/sixorbit": "workspace:*",
    "@tiles-erp/validation": "workspace:*",
    "bullmq": "^5.34.6",
    "ioredis": "^5.4.2",
    "nodemailer": "^6.9.16",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.15",
    "@types/jest": "^29.5.14",
    "@types/nodemailer": "^6.4.17",
    "jest": "^29.7.0",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
