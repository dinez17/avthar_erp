# =====================================================================
# Production edge. Mounted at /etc/nginx/templates/default.conf.template so the
# stock nginx entrypoint runs envsubst over it and writes
# /etc/nginx/conf.d/default.conf at container start.
#
# ${ADMIN_DOMAIN}, ${SUPPLIER_DOMAIN} and ${CUSTOMER_DOMAIN} come from the
# gateway service environment in docker-compose.prod.yml.
# =====================================================================

# Docker's embedded DNS. Needed because the proxy_pass targets below are
# variables, which defers name resolution to request time.
#
# This replaced `upstream { server api:3000; }` blocks. nginx resolves an
# upstream's hostname ONCE, at config load, and refuses to start if it fails:
#
#     [emerg] host not found in upstream "api:3000"
#
# So a crash-looping API took the whole gateway down with it — including the
# three PWAs, which do not depend on the API at all. Resolving per request means
# a backend being down costs a 502 on that route only, and the gateway recovers
# on its own once the backend returns.
resolver 127.0.0.11 valid=10s ipv6=off;
resolver_timeout 5s;

# Needed for the WebSocket upgrade dance: "Connection: upgrade" on an upgrade
# request, "Connection: close" otherwise. Socket.IO falls back to long-polling
# without this, which is slow and breaks sticky assumptions.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# ---------------------------------------------------------------------
# Port 80: ACME challenges only; everything else redirects to HTTPS.
# ---------------------------------------------------------------------
server {
    listen 80 default_server;
    server_name _;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ---------------------------------------------------------------------
# Shared TLS + proxy behaviour.
# ---------------------------------------------------------------------
# Reused by every HTTPS server block below via `include`.

# --- Admin PWA (primary domain) --------------------------------------
server {
    listen 443 ssl;
    http2 on;
    server_name ${ADMIN_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${ADMIN_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${ADMIN_DOMAIN}/privkey.pem;
    include /etc/nginx/snippets/tls.conf;
    include /etc/nginx/snippets/security-headers.conf;

    client_max_body_size 20m;

    location /api/ {
        include /etc/nginx/snippets/proxy.conf;
        set $upstream_api http://api:3000;
        proxy_pass $upstream_api;
    }

    location / {
        include /etc/nginx/snippets/proxy.conf;
        set $upstream_admin http://admin-pwa:80;
        proxy_pass $upstream_admin;
    }
}

# --- Supplier portal --------------------------------------------------
server {
    listen 443 ssl;
    http2 on;
    server_name ${SUPPLIER_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${ADMIN_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${ADMIN_DOMAIN}/privkey.pem;
    include /etc/nginx/snippets/tls.conf;
    include /etc/nginx/snippets/security-headers.conf;

    client_max_body_size 20m;

    location /api/ {
        include /etc/nginx/snippets/proxy.conf;
        set $upstream_api http://api:3000;
        proxy_pass $upstream_api;
    }

    location / {
        include /etc/nginx/snippets/proxy.conf;
        set $upstream_supplier http://supplier-pwa:80;
        proxy_pass $upstream_supplier;
    }
}

# --- Customer portal --------------------------------------------------
server {
    listen 443 ssl;
    http2 on;
    server_name ${CUSTOMER_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${ADMIN_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${ADMIN_DOMAIN}/privkey.pem;
    include /etc/nginx/snippets/tls.conf;
    include /etc/nginx/snippets/security-headers.conf;

    client_max_body_size 20m;

    location /api/ {
        include /etc/nginx/snippets/proxy.conf;
        set $upstream_api http://api:3000;
        proxy_pass $upstream_api;
    }

    location / {
        include /etc/nginx/snippets/proxy.conf;
        set $upstream_customer http://customer-pwa:80;
        proxy_pass $upstream_customer;
    }
}

# --- Anything else on 443 (bare IP, unknown Host) ---------------------
# Answers with the admin certificate and closes; keeps scanners off the app.
server {
    listen 443 ssl default_server;
    http2 on;
    server_name _;

    ssl_certificate     /etc/letsencrypt/live/${ADMIN_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${ADMIN_DOMAIN}/privkey.pem;
    include /etc/nginx/snippets/tls.conf;

    return 444;
}
