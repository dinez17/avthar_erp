{
  "name": "tiles-erp",
  "version": "0.1.0",
  "private": true,
  "description": "Enterprise-grade Tiles ERP - Progressive Web Application monorepo",
  "author": "TilesERP",
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "clean": "turbo run clean && rimraf node_modules",
    "prisma:generate": "pnpm --filter @tiles-erp/api prisma:generate",
    "prisma:migrate": "pnpm --filter @tiles-erp/api prisma:migrate",
    "prisma:seed": "pnpm --filter @tiles-erp/api prisma:seed",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.yml down",
    "dev:docker": "docker compose -f docker/docker-compose.dev.yml up",
    "dev:docker:build": "docker compose -f docker/docker-compose.dev.yml up --build",
    "dev:docker:down": "docker compose -f docker/docker-compose.dev.yml down",
    "dev:docker:reset": "docker compose -f docker/docker-compose.dev.yml down -v",
    "dev:docker:logs": "docker compose -f docker/docker-compose.dev.yml logs -f api worker",
    "dev:docker:shell": "docker compose -f docker/docker-compose.dev.yml exec api sh",
    "prepare": "husky || true",
    "sixorbit:preview": "pnpm --filter @tiles-erp/api sixorbit:preview"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/js": "^9.17.0",
    "@tiles-erp/config": "workspace:*",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.5",
    "bcryptjs": "^2.4.3",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "prettier": "^3.4.2",
    "prisma": "^6.1.0",
    "rimraf": "^6.0.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@prisma/client": "6.19.3"
  }
}
