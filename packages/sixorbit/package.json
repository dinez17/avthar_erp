{
  "name": "@tiles-erp/sixorbit",
  "version": "0.1.0",
  "private": true,
  "description": "SixOrbit API client and mapping domain, shared by the API and the worker",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "clean": "rimraf dist .turbo",
    "test": "jest"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@tiles-erp/config": "workspace:*",
    "@tiles-erp/shared": "workspace:*",
    "@tiles-erp/shared-types": "workspace:*"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
